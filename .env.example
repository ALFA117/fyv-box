# Supabase (proyecto con las migraciones de supabase/migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SOLO servidor

# Pollar: llave PUBLICABLE pub_testnet_… (dashboard.pollar.xyz). Vacía = solo modo invitado
NEXT_PUBLIC_POLLAR_API_KEY=

# IA gratuita del asistente: llave de Gemini (aistudio.google.com, nivel gratuito). SOLO servidor.
# Sin ella usa Pollinations (sin llave) y, si falla, respuestas predeterminadas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Credenciales on-chain: cuenta testnet fondeada con Friendbot
FYV_ATTESTOR_SECRET=              # SOLO servidor (S…)
NEXT_PUBLIC_FYV_ATTESTOR=         # su dirección pública (G…)
NEXT_PUBLIC_FYV_CREDENTIAL_CONTRACT= # contrato Soroban de credenciales (C…)

REGISTRY_BACKEND=supabase
NEXT_PUBLIC_SITE_URL=
